# URL interna de Docker — Next.js la usa en el servidor (SSR) para llegar a Drupal
# En local: http://backend:80 | En producción: http://backend:80 (mismo nombre de servicio)
DRUPAL_BASE_URL=http://backend:80

# URL pública de Drupal — se embebe en el bundle del browser
# En local: http://localhost:8080 | En producción: https://api.tudominio.com
NEXT_PUBLIC_DRUPAL_BASE_URL=http://localhost:8080

# Dominio de Drupal para next/image (sin protocolo)
# En local: backend | En producción: api.tudominio.com
NEXT_IMAGE_DOMAIN=backend

# Protocolo de las imágenes remotas
# En local: http | En producción: https
NEXT_IMAGE_PROTOCOL=http

# URL canonica del sitio para metadata y sitemap
# En local: http://localhost:3000 | En produccion: https://www.example.edu.co
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# UUID del nodo Drupal usado por /acerca-de
DRUPAL_ABOUT_PAGE_UUID=

# Solo si usas draft mode o contenido privado (OAuth):
# DRUPAL_CLIENT_ID=
# DRUPAL_CLIENT_SECRET=

# Solo si usas revalidación on-demand:
# DRUPAL_REVALIDATE_SECRET=